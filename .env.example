# Meta Pixel. Set this in Vercel for Production, Preview and Development.
#
# NEXT_PUBLIC_ so it reaches the browser, which a pixel has to. It is not a secret: the id is
# visible in the page source of every site that runs one.
#
# With it unset, components/analytics/meta-pixel.tsx renders nothing and no events are sent. That
# is on purpose, so local work and any preview build that has not been given the variable cannot
# post test traffic into the client's live reporting.
NEXT_PUBLIC_META_PIXEL_ID=1257921641990006
